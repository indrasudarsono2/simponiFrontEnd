NODE_ENV=development
NITRO_HOST=0.0.0.0
NITRO_PORT=44440

# Internal backend address used by Nuxt server routes.
NUXT_IP_BACK_END=localhost:44441

# Public frontend origin. Use HTTPS in production.
NUXT_PUBLIC_SITE_URL=http://localhost:44440

# Public API origin. Production builds require HTTPS.
NUXT_PUBLIC_API_BASE_URL=http://localhost:44441

# Authentication provider: airnav (SSO), local (PERFORMA credentials), or hybrid (both).
NUXT_PUBLIC_AUTH_PROVIDER=hybrid

# Emergency rollback: set to false to restore camera-only exam monitoring.
NUXT_PUBLIC_SCREEN_MONITORING_ENABLED=true
